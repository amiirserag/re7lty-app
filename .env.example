# Supabase (optional). When both are set, the app uses real Supabase auth
# (email/password + Google/Apple OAuth) and syncs bookings/favorites/profile.
# When unset, the app runs fully locally (localStorage accounts, simulated OAuth).
#
# Dashboard "Publishable" keys (sb_publishable_…) go in VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
